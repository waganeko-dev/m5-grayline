#!/usr/bin/env bash
# Rejects pushes to main and to branches whose names break the naming rule
# in .githooks/branch-name-pattern (see AGENTS.md).
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
pattern="$(head -n 1 "$root/.githooks/branch-name-pattern")"
zero="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/*) branch="${remote_ref#refs/heads/}" ;;
    *) continue ;;   # tags and other refs are not checked here
  esac
  if [ "$branch" = "main" ]; then
    echo "pre-push: do not push to main directly; open a pull request from a feature/fix/docs/chore branch." >&2
    status=1
  elif [ "$local_sha" != "$zero" ] && ! printf '%s\n' "$branch" | grep -Eq "$pattern"; then
    echo "pre-push: branch name '$branch' is not allowed." >&2
    echo "          Use feature/..., fix/..., docs/... or chore/... (lowercase, hyphens)." >&2
    status=1
  fi
done

exit "$status"

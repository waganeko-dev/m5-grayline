---
// Starlight's footer plus a link box to the blog article in the page's language (URLs in src/site.config.mjs).
import Default from '@astrojs/starlight/components/Footer.astro';
import { BLOG_URL } from '../site.config.mjs';

const isJa = Astro.locals.starlightRoute.lang === 'ja';
const text = isJa
  ? { url: BLOG_URL.ja, title: 'ブログ記事', body: '作った経緯や、実機の写真と動画をブログ記事で紹介しています。', link: 'ブログ記事を読む' }
  : { url: BLOG_URL.en, title: 'Blog article', body: 'The blog article tells why I made it and shows the device in photos and a video.', link: 'Read the article' };
---

<Default />
<aside class="blog-box" aria-label={text.title}>
  <p class="blog-title">{text.title}</p>
  <p>{text.body}</p>
  <a href={text.url} rel="noopener">{text.link} →</a>
</aside>

<style>
  .blog-box {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
    font-size: var(--sl-text-sm);
  }
  .blog-box p { margin: 0 0 0.5rem; }
  .blog-title { font-weight: 600; color: var(--sl-color-white); }
</style>
